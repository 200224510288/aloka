# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout.
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.css text
*.md text
*.html text

# Declare binary files - Git will not try to modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary
